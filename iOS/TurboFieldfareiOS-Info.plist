<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- BackgroundDownload: each download's continued-processing task gets
	     a unique identifier under this prefix. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.github.maxslamdunk.TurboFieldfareiOS.download.*</string>
		<string>io.github.maxslamdunk.TurboFieldfareiOS.probe.*</string>
	</array>
	<!-- BackgroundProbe: Picture in Picture needs this mode. It does not keep
	     the app running by itself; only playing audio or PiP would. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
