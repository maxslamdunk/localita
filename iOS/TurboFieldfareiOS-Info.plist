<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- BackgroundDownload: each download's continued-processing task gets
	     a unique identifier under this prefix. It follows the bundle ID, so a
	     build under another bundle ID keeps background downloads working. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).download.*</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).probe.*</string>
	</array>
	<!-- Picture in Picture needs this mode: BackgroundGeneration keeps a reply
	     generating in a PiP window, and BackgroundProbe measured why that
	     works. It does not keep the app running by itself; only playing audio
	     or PiP would. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
