# Swift Package Manager
.build/
.swiftpm/
*.xcodeproj
*.xcworkspace

# Xcode
DerivedData/
xcuserdata/
*.xcuserstate
*.xcscheme

# macOS
.DS_Store

# Build artifacts
*.o
*.a
*.dylib
*.metallib

# Model weights / large blobs
*.safetensors
*.gguf
*.bin
*.npz
*.pdf
weights/
models/
Model/
!Tests/**/Model/
# Repacked .gturbo directories (manifest.json/layout.json inside aren't caught by *.bin)
*.gturbo/

# Editor
.vscode/
.idea/
*.swp
*~

# Logs / scratch
*.log
benchmark-results/
/scratch
tmp/

# Python
__pycache__/
*.pyc
.venv/

# Tool-specific agent setup stays local. AGENTS.md is the shared guide; Claude
# Code users put `@AGENTS.md` in their own CLAUDE.md.
CLAUDE.md
CLAUDE.local.md
.claude/

# Compiled standalone probes (sources are tracked)
Scripts/probes/*
!Scripts/probes/*.c

# The iOS app target is hand-written and IS the deliverable, so it is tracked
# despite the blanket *.xcodeproj / *.xcscheme rules above. An app bundle cannot
# be expressed in Package.swift, so losing this project would mean the port
# could not be rebuilt. `xcuserdata/` stays ignored.
!iOS/TurboFieldfareiOS.xcodeproj/
!iOS/TurboFieldfareiOS.xcodeproj/project.pbxproj
!iOS/TurboFieldfareiOS.xcodeproj/xcshareddata/
!iOS/TurboFieldfareiOS.xcodeproj/xcshareddata/**/*.xcscheme
# The fitted next-layer guess ships with the runtime (NextLayerGuessWeights).
!Sources/TurboFieldfare/NextLayerGuess/*.bin
